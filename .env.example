# Chave da API Gemini (obrigatória)
GEMINI_API_KEY=

# Porta HTTP da aplicação
PORT=8080

# Expõe detalhes técnicos em erros 5xx (use apenas para depuração)
EXPOSE_ERRORS=false

# Rate limit por IP nos endpoints /api/sinteses/**
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Lista de IPs de proxies reversos confiáveis (CSV). Vazio = não confiar em X-Forwarded-For
RATE_LIMIT_TRUSTED_PROXIES=
